PORT=4701
NODE_ENV=development
DB_NAME=chat_system
DB_USER=root
DB_PASS=root
DB_HOST=localhost
DB_PORT=3306
CLIENT_URL=http://localhost:5174,http://127.0.0.1:5174
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Single issuer shortcut. Production deployments should use CHAT_AUTH_ISSUERS.
SERVER_SECRETS=replace-with-at-least-32-random-bytes
CHAT_JWT_ISSUER=chat-local
CHAT_JWT_AUDIENCE=chat-api
CHAT_JWT_ALGORITHMS=HS256
CHAT_REQUIRE_JTI=true
CHAT_ALLOWED_APPS=ticket_portal,hr,crm

# Multi-issuer example (use RS256 public keys in production where possible).
# CHAT_AUTH_ISSUERS={"https://id.company.test":{"audience":"chat-api","algorithms":["RS256"],"publicKey":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----","apps":["ticket_portal","crm"]}}

CHAT_ENABLE_PASSWORD_AUTH=false
CHAT_FRAME_ANCESTORS='self' http://localhost:3000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=300
TRUST_PROXY_HOPS=0
CHAT_AUTH_RATE_LIMIT_MAX=15
DB_POOL_MAX=10
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

# Automatically recover when a browser closes without sending the call-end event.
CHAT_CALL_RING_TIMEOUT_MS=120000
CHAT_CALL_CONNECT_TIMEOUT_MS=120000
CHAT_CALL_MAX_DURATION_MS=14400000

# One directory endpoint may be configured for each source application.
# CHAT_PROVIDER_TICKET_PORTAL_USERS_URL=https://ticket.example/api/chat/users
